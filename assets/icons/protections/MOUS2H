<!-- WorkIt - MOUSTIQUAIRE LATERALE DOUBLE | coffre gauche + coffre droit -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="none">

  <!-- Structure principale -->
  <g stroke="currentColor" stroke-width="22" stroke-linecap="round" stroke-linejoin="round">

    <!-- Cadre extérieur -->
    <rect x="96" y="80" width="320" height="352" rx="24"/>

    <!-- Coffre gauche -->
    <line x1="124" y1="80" x2="124" y2="432"/>

    <!-- Coffre droit -->
    <line x1="388" y1="80" x2="388" y2="432"/>

    <!-- Jonction centrale (barre de fermeture double) -->
    <line x1="256" y1="108" x2="256" y2="404"/>

    <!-- Poignée centrale -->
    <line x1="240" y1="240" x2="272" y2="240"/>

  </g>

  <!-- Grillage fin (2 zones) -->
  <g stroke="currentColor" stroke-width="3" opacity="0.35">

    <!-- Grillage gauche -->
    <line x1="150" y1="108" x2="150" y2="404"/>
    <line x1="190" y1="108" x2="190" y2="404"/>
    <line x1="230" y1="108" x2="230" y2="404"/>

    <!-- Grillage droit -->
    <line x1="282" y1="108" x2="282" y2="404"/>
    <line x1="322" y1="108" x2="322" y2="404"/>
    <line x1="362" y1="108" x2="362" y2="404"/>

    <!-- Lignes horizontales communes -->
    <line x1="124" y1="140" x2="388" y2="140"/>
    <line x1="124" y1="180" x2="388" y2="180"/>
    <line x1="124" y1="220" x2="388" y2="220"/>
    <line x1="124" y1="260" x2="388" y2="260"/>
    <line x1="124" y1="300" x2="388" y2="300"/>
    <line x1="124" y1="340" x2="388" y2="340"/>

  </g>

</svg>
