<!-- WorkIt - OB2 (Oscillo-battant 2 battants) | base OF2 + badge "OB" | currentColor -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="none">

  <!-- Structure (exactement comme OF2) -->
  <g stroke="currentColor" stroke-width="22" stroke-linecap="round" stroke-linejoin="round">
    <!-- Cadre extérieur -->
    <rect x="96" y="80" width="320" height="352" rx="24"/>

    <!-- 2 ouvrants (cadres intérieurs) -->
    <rect x="124" y="108" width="124" height="296" rx="18"/>
    <rect x="264" y="108" width="124" height="296" rx="18"/>

    <!-- Meneau central -->
    <line x1="256" y1="108" x2="256" y2="404"/>

    <!-- Poignées (côté centre) -->
    <line x1="236" y1="240" x2="236" y2="292"/>
    <line x1="276" y1="240" x2="276" y2="292"/>

    <!-- Paumelles (battant gauche : charnières à gauche) -->
    <line x1="142" y1="140" x2="142" y2="170"/>
    <line x1="142" y1="342" x2="142" y2="372"/>

    <!-- Paumelles (battant droit : charnières à droite) -->
    <line x1="370" y1="140" x2="370" y2="170"/>
    <line x1="370" y1="342" x2="370" y2="372"/>
  </g>

  <!-- Badge "OB" -->
  <g stroke="currentColor" stroke-width="18" stroke-linecap="round" stroke-linejoin="round">
    <rect x="154" y="124" width="92" height="56" rx="16"/>
  </g>

  <!-- Texte "OB" -->
  <text x="200" y="162"
        text-anchor="middle"
        font-family="system-ui, -apple-system, Segoe UI, Roboto, Arial"
        font-size="28"
        font-weight="700"
        fill="currentColor">OB</text>
</svg>

