rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Lit le document users/{uid} de l'appelant (pour get individuel uniquement)
    function me() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function myWorkspaceId() {
      let d = me();
      return d.get('workspaceId', d.get('companyId', ''));
    }

    function myRole() {
      return me().role;
    }

    // ─── Collection users/ ───────────────────────────────────────────────────

    match /users/{userId} {
      // GET par ID : soi-même ou membre du même workspace
      allow get: if isAuth() && (
        uid() == userId ||
        myWorkspaceId() == resource.data.get('workspaceId', resource.data.get('companyId', '___'))
      );

      // LIST (query) : uniquement les documents du même workspace que
      // l'appelant, quelle que soit la requête envoyée par le client.
      allow list: if isAuth() && (
        myWorkspaceId() == resource.data.get('workspaceId', resource.data.get('companyId', '___'))
      );

      // Création : uniquement l'auto-inscription d'un nouvel admin lors de
      // la création de son propre workspace (onboarding). Le workspace
      // référencé doit déjà exister avec adminUid == uid() — bloque toute
      // création directe d'un compte non-admin ou pointant vers un
      // workspace existant appartenant à quelqu'un d'autre. Les comptes
      // commercial/métreur/poseur sont provisionnés par la Cloud Function
      // provisionAccounts (Admin SDK, ne passe pas par ces règles).
      allow create: if isAuth() && uid() == userId &&
        request.resource.data.role == 'admin' &&
        request.resource.data.get('workspaceId', null) != null &&
        get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.adminUid == uid();

      // Mise à jour : soi-même — mais sans pouvoir changer role,
      // workspaceId, companyId, canManageTeam, manageableRoles ou isAdmin
      // (ces champs ne sont modifiables que par une Cloud Function via
      // Admin SDK, ou par un admin ci-dessous), et sans pouvoir sortir de
      // status=='disabled' soi-même — ou admin du même workspace (droits
      // inchangés, y compris sur ces champs).
      allow update: if isAuth() && (
        (uid() == userId &&
          request.resource.data.get('role', null) == resource.data.get('role', null) &&
          request.resource.data.get('workspaceId', null) == resource.data.get('workspaceId', null) &&
          request.resource.data.get('companyId', null) == resource.data.get('companyId', null) &&
          request.resource.data.get('canManageTeam', false) == resource.data.get('canManageTeam', false) &&
          request.resource.data.get('manageableRoles', []) == resource.data.get('manageableRoles', []) &&
          request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
          (resource.data.get('status', '') != 'disabled' || request.resource.data.get('status', '') == 'disabled')
        ) ||
        (myRole() == 'admin' &&
         myWorkspaceId() == resource.data.get('workspaceId', resource.data.get('companyId', '___')))
      );

      allow delete: if false;
    }

    // ─── Collection workspaces/ ──────────────────────────────────────────────

    match /workspaces/{workspaceId} {
      // GET : admin direct (via adminUid) ou membre (via workspaceId dans user doc)
      allow get: if isAuth() && (
        resource.data.adminUid == uid() ||
        myWorkspaceId() == workspaceId
      );

      // LIST : restreint aux membres du workspace
      allow list: if isAuth() && (
        resource.data.adminUid == uid() ||
        myWorkspaceId() == workspaceId
      );

      // Création : l'admin crée son propre workspace
      allow create: if isAuth() && request.resource.data.adminUid == uid();

      // Mise à jour : admin ou membre
      allow update: if isAuth() && (
        resource.data.adminUid == uid() ||
        myWorkspaceId() == workspaceId
      );

      allow delete: if false;

      // ── Sous-collection devis/ ──────────────────────────────────────────

      match /devis/{devisId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
          myWorkspaceId() == workspaceId
        );

        // Création : reste une écriture client directe, mais le statut
        // initial ne peut être que 'Nouvelle demande' — impossible de créer
        // un chantier déjà avancé.
        allow create: if isAuth() && (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
          myWorkspaceId() == workspaceId
        ) && request.resource.data.get('status', null) == 'Nouvelle demande';

        // Mise à jour : tout champ reste modifiable directement SAUF le
        // statut — toute transition passe désormais par la Cloud Function
        // transitionDevisStatus (Admin SDK, contourne ces règles), seule
        // habilitée à vérifier les droits par rôle et à écrire l'historique.
        allow update: if isAuth() && (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
          myWorkspaceId() == workspaceId
        ) && request.resource.data.get('status', null) == resource.data.get('status', null)
          && request.resource.data.get('metreurStatus', null) == resource.data.get('metreurStatus', null);

        allow delete: if false;

        // ── Messagerie interne du chantier ──────────────────────────────
        match /messages/{messageId} {
          allow read, write: if isAuth() && (
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
            myWorkspaceId() == workspaceId
          );
        }

        // ── Historique immuable des transitions de statut ───────────────
        match /statusHistory/{historyId} {
          allow read: if isAuth() && (
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
            myWorkspaceId() == workspaceId
          );
          allow write: if false;
        }

        // ── Documents générés (bon de commande, bon de préparation, ────
        // rapport d'autocontrôle...) — créés côté client par DocumentEngine
        // (contrairement à statusHistory, pas via Cloud Function), jamais
        // modifiés ni supprimés après coup.
        match /documents/{documentId} {
          allow read, create: if isAuth() && (
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
            myWorkspaceId() == workspaceId
          );
          allow update, delete: if false;
        }

        // ── Lots (Phase 3, multi-lots) — un lot par métier distinct parmi ─
        // les produits du chantier, créés par transitionDevisStatus au
        // passage "À commander" (Admin SDK). Même principe que
        // statusHistory : lecture ouverte aux membres du workspace, écriture
        // exclusivement serveur (jamais de write client direct, y compris
        // pour `dependsOn` — passe par la Cloud Function setLotDependencies
        // pour valider les IDs et détecter les cycles).
        match /lots/{lotId} {
          allow read: if isAuth() && (
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
            myWorkspaceId() == workspaceId
          );
          allow write: if false;

          match /statusHistory/{historyId} {
            allow read: if isAuth() && (
              get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
              myWorkspaceId() == workspaceId
            );
            allow write: if false;
          }
        }
      }

      // ── Sous-collection invites/ ────────────────────────────────────────

      match /invites/{inviteId} {
        allow read: if isAuth();
        allow create, update: if isAuth() && (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
          myWorkspaceId() == workspaceId
        );
        allow delete: if false;
      }

      // ── Sous-collection planningTeams/ (Planner) ────────────────────────

      match /planningTeams/{teamId} {
        allow read, write: if isAuth() && (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
          myWorkspaceId() == workspaceId
        );
      }

      // ── Sous-collection unavailabilities/ (Planner) ─────────────────────

      match /unavailabilities/{unavailabilityId} {
        allow read, write: if isAuth() && (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
          myWorkspaceId() == workspaceId
        );
      }

      // ── Sous-collection usage/ (quotas, ex. analyses IA) ────────────────
      // Écrite uniquement par les Cloud Functions (Admin SDK, contourne ces
      // règles) ; lecture seule pour un futur affichage côté Réglages.

      match /usage/{usageId} {
        allow read: if isAuth() && myWorkspaceId() == workspaceId;
        allow write: if false;
      }

      // ── Sous-collection auditLogs/ (journal immuable) ───────────────────

      match /auditLogs/{logId} {
        allow read, create: if isAuth() && (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.adminUid == uid() ||
          myWorkspaceId() == workspaceId
        );
        allow update, delete: if false;
      }
    }

    // ─── Collections utilitaires ─────────────────────────────────────────────

    match /trial_sessions/{sessionId} {
      allow read, write: if isAuth();
    }

    match /provisioned_accounts/{accountId} {
      // Lecture/mise à jour réservées aux membres du même workspace (le
      // document porte déjà workspaceId/companyId). Création et
      // suppression refusées aux clients : seule provisionAccounts
      // (Admin SDK, contourne ces règles) crée ces documents.
      allow read, update: if isAuth() &&
        myWorkspaceId() == resource.data.get('workspaceId', resource.data.get('companyId', '___'));
      allow create, delete: if false;
    }
  }
}
